#!/bin/sh
set -u
JBROOT=$(CDPATH= cd -- /var/jb 2>/dev/null && pwd -P) || exit 0
LAUNCHCTL=""
for candidate in $JBROOT/usr/bin/launchctl $JBROOT/usr/sbin/launchctl $JBROOT/basebin/launchctl $JBROOT/bin/launchctl $JBROOT/sbin/launchctl /bin/launchctl /sbin/launchctl /usr/bin/launchctl /usr/sbin/launchctl /usr/libexec/launchctl; do
  if [ -x "$candidate" ]; then LAUNCHCTL="$candidate"; break; fi
done
if [ -z "$LAUNCHCTL" ] && [ -d "$JBROOT" ]; then
  LAUNCHCTL="$(find "$JBROOT" -name launchctl -perm -111 -print -quit 2>/dev/null || true)"
fi
if [ -z "$LAUNCHCTL" ] && command -v launchctl >/dev/null 2>&1; then LAUNCHCTL="$(command -v launchctl)"; fi
if [ -n "$LAUNCHCTL" ]; then
  "$LAUNCHCTL" bootout system $JBROOT/Library/LaunchDaemons/com.idevelab.core.alpha11.plist >/dev/null 2>&1 || true
  "$LAUNCHCTL" bootout system $JBROOT/Library/LaunchDaemons/com.idevelab.maintenance.alpha11.plist >/dev/null 2>&1 || true
fi
exit 0
